# 값은 .env.local에만 채운다. 이 파일에는 키 이름만 적는다.

# 카카오 (장소·역 검색: 서버 전용 / 지도 표시: 브라우저 공개)
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_JS_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 공개하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# ODsay 대중교통 이동 시간 (서버 전용)
ODSAY_API_KEY=
# 웹 플랫폼 키는 ODsay 콘솔에 등록한 URL 과 같은 값이어야 한다. 배포 시 Vercel 주소로 바꾼다. (기본 http://localhost:3000)
ODSAY_ORIGIN=
